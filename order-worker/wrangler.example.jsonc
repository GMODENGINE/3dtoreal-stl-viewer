{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dttr-order-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "ORDER_FILES",
      "id": "a2ff37c7cebf4382ae9d66bb7bcf2fad"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
